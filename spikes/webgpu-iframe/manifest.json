{
  "manifest_version": 3,
  "name": "Lensing spike — WebGPU in extension iframe",
  "version": "0.0.1",
  "description": "Spike 12.1. Does requestAdapter() resolve inside an extension iframe injected into a real feed?",
  "content_scripts": [
    {
      "matches": ["*://x.com/*", "*://twitter.com/*", "*://*.reddit.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["engine.html", "engine.js", "worker.js"],
      "matches": ["*://x.com/*", "*://twitter.com/*", "*://*.reddit.com/*"]
    }
  ],
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "browser_specific_settings": { "gecko": { "id": "lensing-spike@local" } }
}
