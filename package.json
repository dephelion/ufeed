{
  "name": "feedlens",
  "description": "Name the topics you want. FeedLens blurs the rest of your X, LinkedIn and Reddit feed. Private, on-device, no account.",
  "private": true,
  "license": "GPL-3.0-or-later",
  "version": "0.7.0",
  "type": "module",
  "scripts": {
    "dev": "wxt",
    "dev:firefox": "wxt -b firefox",
    "build": "wxt build && wxt build -b firefox",
    "build:firefox": "wxt build -b firefox",
    "zip": "wxt zip",
    "zip:firefox": "wxt zip -b firefox",
    "compile": "tsc --noEmit",
    "check": "npm run format:check && npm run compile && npm test && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "vitest run",
    "test:watch": "vitest",
    "postinstall": "node scripts/sync-ort.mjs && wxt prepare",
    "sync:ort": "node scripts/sync-ort.mjs",
    "watch": "node scripts/watch-build.mjs",
    "test:model": "vitest run --config vitest.model.config.ts",
    "build:debug": "VITE_FEEDLENS_DEBUG=1 wxt build",
    "build:debug:firefox": "VITE_FEEDLENS_DEBUG=1 wxt build -b firefox"
  },
  "dependencies": {
    "@huggingface/transformers": "^3.7.6",
    "webextension-polyfill": "^0.12.0"
  },
  "devDependencies": {
    "@types/webextension-polyfill": "^0.12.3",
    "happy-dom": "^20.14.3",
    "prettier": "^3.9.6",
    "typescript": "^5.9.3",
    "vitest": "^3.2.4",
    "wxt": "^0.20.12"
  }
}
